{
  "name": "StyleTower",
  "version": "1.0.21",
  "manifest_version": 3,
  "description": "Customizable themes for holotower.org.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [{
    "js": ["script.js"],
    "matches": ["*://holotower.org/*","*://boards.holotower.org/*","*://text.holotower.org/*"],
    "exclude_matches": ["*://holotower.org/mod.php*","*://boards.holotower.org/mod.php*","*://text.holotower.org/mod.php*"],
    "run_at": "document_end"
  }],
  "homepage_url": "https://github.com/vampiricwulf/StyleTower/",
  "permissions": ["storage"],
  "host_permissions": ["*://holotower.org/*","*://boards.holotower.org/*","*://text.holotower.org/*"]
}
