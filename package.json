{
  "name": "StyleTower",
  "version": "1.0.14",
  "description": "Customizable themes for holotower.org.",
  "scripts": {
    "lint": "eslint src/",
    "build": "grunt build"
  },
  "meta": {
    "name": "StyleTower",
    "repo": "https://github.com/vampiricwulf/StyleTower/",
    "page": "https://github.com/vampiricwulf/StyleTower/",
    "downloads": "https://github.com/vampiricwulf/StyleTower/releases/latest/download/",
    "appid": "peblejlenbfconioafjbmipeogjdhcff",
    "buildsPath": "builds/",
    "mainBranch": "main",
    "matches": [
      "*://holotower.org/*",
      "*://boards.holotower.org/*"
    ],
    "exclude_matches": [
      "*://holotower.org/mod.php*",
      "*://boards.holotower.org/mod.php*"
    ],
    "files": {
      "metajs": "StyleTower.meta.js",
      "userjs": "StyleTower.user.js",
      "minmetajs": "StyleTower.min.meta.js",
      "minuserjs": "StyleTower.min.user.js"
    },
    "min": {
      "chrome": "32",
      "firefox": "26",
      "greasemonkey": "1.14"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "grunt": "^1.6.1",
    "grunt-bump": "^0.8.0",
    "grunt-contrib-clean": "^2.0.1",
    "grunt-contrib-compress": "^2.0.0",
    "grunt-contrib-concat": "~0.5.0",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-contrib-cssmin": "^5.0.0",
    "grunt-contrib-uglify": "^5.2.2",
    "grunt-shell": "~1.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vampiricwulf/StyleTower.git"
  },
  "author": "seaweedchan",
  "contributors": [
    "3nly<3nly.github.com>",
    "VampiricWulf/KanashiiWolf<github.com/vampiricwulf>",
    "Claude Code's Stolen Data"
  ],
  "namespace": "seaweedchan.github.com",
  "license": "GPL-3.0",
  "readmeFilename": "README.md",
  "engines": {
    "node": ">=0.10"
  },
  "dependencies": {
    "coffeescript": "^2.7.0"
  }
}
