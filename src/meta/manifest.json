{
  "name": "<%= meta.name %>",
  "version": "<%= version %>",
  "manifest_version": 3,
  "description": "<%= description %>",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [{
    "js": ["script.js"],
    "matches": <%= JSON.stringify(meta.matches) %>,
    "exclude_matches": <%= JSON.stringify(meta.exclude_matches) %>,
    "run_at": "document_end"
  }],
  "homepage_url": "<%= meta.page %>",
  "permissions": ["storage"],
  "host_permissions": <%= JSON.stringify(meta.matches) %>
}
